{
  "meta": {
    "format": "httpie",
    "version": "1.0.0",
    "contentType": "workspace",
    "schema": "https://github.com/httpie/schema/blob/main/versions/1.0.0/schema.json",
    "source": "vertx5-mcp"
  },
  "entry": {
    "id": "ws_vertx5mcp",
    "name": "vertx5-mcp",
    "icon": { "name": "rocket", "color": "blue" },
    "drafts": [],
    "environments": [
      {
        "id": "env_defaults",
        "name": "Defaults",
        "isDefault": true,
        "isLocalOnly": false,
        "variables": [
          { "id": "var_agentBase",    "name": "agentBase",    "value": "http://localhost:8080", "isSecret": false },
          { "id": "var_mcpBase",      "name": "mcpBase",      "value": "http://localhost:3001", "isSecret": false },
          { "id": "var_mcpSessionId", "name": "mcpSessionId", "value": "",                     "isSecret": false }
        ]
      }
    ],
    "collections": [
      {
        "id": "col_health",
        "name": "Health",
        "auth": { "type": "none" },
        "icon": { "name": "monitor", "color": "green" },
        "requests": [
          {
            "id": "req_health",
            "name": "Health Check",
            "method": "GET",
            "url": "{{agentBase}}/health",
            "auth": { "type": "inherited" },
            "headers": [],
            "queryParams": [],
            "pathParams": [],
            "body": { "type": "none" }
          }
        ]
      },
      {
        "id": "col_trade",
        "name": "Trade Failures",
        "auth": { "type": "none" },
        "icon": { "name": "database", "color": "orange" },
        "requests": [
          {
            "id": "req_t100",
            "name": "1) T-100 — Known deterministic (Missing ISIN)",
            "method": "POST",
            "url": "{{agentBase}}/trade/failures",
            "auth": { "type": "inherited" },
            "headers": [
              { "enabled": true, "name": "Content-Type", "value": "application/json" }
            ],
            "queryParams": [],
            "pathParams": [],
            "body": {
              "type": "text",
              "text": {
                "format": "application/json",
                "value": "{\n  \"tradeId\": \"T-100\",\n  \"reason\": \"Missing ISIN\"\n}"
              }
            }
          },
          {
            "id": "req_t200",
            "name": "2) T-200 — Unknown failure (agent classification)",
            "method": "POST",
            "url": "{{agentBase}}/trade/failures",
            "auth": { "type": "inherited" },
            "headers": [
              { "enabled": true, "name": "Content-Type", "value": "application/json" }
            ],
            "queryParams": [],
            "pathParams": [],
            "body": {
              "type": "text",
              "text": {
                "format": "application/json",
                "value": "{\n  \"tradeId\": \"T-200\",\n  \"reason\": \"LEI not found in registry\"\n}"
              }
            }
          },
          {
            "id": "req_t500",
            "name": "3) T-500 — Settlement mismatch · FX root-cause hypothesis (4 steps)",
            "method": "POST",
            "url": "{{agentBase}}/trade/failures",
            "auth": { "type": "inherited" },
            "headers": [
              { "enabled": true, "name": "Content-Type", "value": "application/json" }
            ],
            "queryParams": [],
            "pathParams": [],
            "body": {
              "type": "text",
              "text": {
                "format": "application/json",
                "value": "{\n  \"tradeId\": \"T-500\",\n  \"reason\": \"Settlement amount mismatch detected\"\n}"
              }
            }
          },
          {
            "id": "req_t600",
            "name": "4) T-600 — Duplicate trade detection · risk exposure analysis (4 steps)",
            "method": "POST",
            "url": "{{agentBase}}/trade/failures",
            "auth": { "type": "inherited" },
            "headers": [
              { "enabled": true, "name": "Content-Type", "value": "application/json" }
            ],
            "queryParams": [],
            "pathParams": [],
            "body": {
              "type": "text",
              "text": {
                "format": "application/json",
                "value": "{\n  \"tradeId\": \"T-600\",\n  \"reason\": \"Possible duplicate trade execution\"\n}"
              }
            }
          },
          {
            "id": "req_t700",
            "name": "5) T-700 — Regulatory T+1 deadline · compliance urgency (4 steps)",
            "method": "POST",
            "url": "{{agentBase}}/trade/failures",
            "auth": { "type": "inherited" },
            "headers": [
              { "enabled": true, "name": "Content-Type", "value": "application/json" }
            ],
            "queryParams": [],
            "pathParams": [],
            "body": {
              "type": "text",
              "text": {
                "format": "application/json",
                "value": "{\n  \"tradeId\": \"T-700\",\n  \"reason\": \"Regulatory T+1 deadline at risk\"\n}"
              }
            }
          },
          {
            "id": "req_t800",
            "name": "6) T-800 — Sanctions screening · false-positive analysis (5 steps)",
            "method": "POST",
            "url": "{{agentBase}}/trade/failures",
            "auth": { "type": "inherited" },
            "headers": [
              { "enabled": true, "name": "Content-Type", "value": "application/json" }
            ],
            "queryParams": [],
            "pathParams": [],
            "body": {
              "type": "text",
              "text": {
                "format": "application/json",
                "value": "{\n  \"tradeId\": \"T-800\",\n  \"reason\": \"OFAC screening flag on counterparty\"\n}"
              }
            }
          },
          {
            "id": "req_t900",
            "name": "7) T-900 — Multi-leg cascade · structural reasoning (5 steps)",
            "method": "POST",
            "url": "{{agentBase}}/trade/failures",
            "auth": { "type": "inherited" },
            "headers": [
              { "enabled": true, "name": "Content-Type", "value": "application/json" }
            ],
            "queryParams": [],
            "pathParams": [],
            "body": {
              "type": "text",
              "text": {
                "format": "application/json",
                "value": "{\n  \"tradeId\": \"T-900\",\n  \"reason\": \"Linked trade cascade failure on swap leg\"\n}"
              }
            }
          },
          {
            "id": "req_t1000",
            "name": "8) T-1000 — Counterparty credit event · portfolio analysis (5 steps)",
            "method": "POST",
            "url": "{{agentBase}}/trade/failures",
            "auth": { "type": "inherited" },
            "headers": [
              { "enabled": true, "name": "Content-Type", "value": "application/json" }
            ],
            "queryParams": [],
            "pathParams": [],
            "body": {
              "type": "text",
              "text": {
                "format": "application/json",
                "value": "{\n  \"tradeId\": \"T-1000\",\n  \"reason\": \"Counterparty credit downgrade to CCC+\"\n}"
              }
            }
          }
        ]
      },
      {
        "id": "col_mcp_streamable",
        "name": "MCP — Streamable HTTP (2025-03-26)",
        "auth": { "type": "none" },
        "icon": { "name": "globe", "color": "aqua" },
        "requests": [
          {
            "id": "req_mcp_init",
            "name": "1) Initialize session",
            "method": "POST",
            "url": "{{mcpBase}}/mcp",
            "auth": { "type": "inherited" },
            "headers": [
              { "enabled": true, "name": "Content-Type", "value": "application/json" },
              { "enabled": true, "name": "Accept",       "value": "application/json" }
            ],
            "queryParams": [],
            "pathParams": [],
            "body": {
              "type": "text",
              "text": {
                "format": "application/json",
                "value": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"initialize\",\n  \"params\": {\n    \"protocolVersion\": \"2025-03-26\",\n    \"capabilities\": {},\n    \"clientInfo\": { \"name\": \"httpie\", \"version\": \"1.0\" }\n  }\n}"
              }
            }
          },
          {
            "id": "req_mcp_tools_list",
            "name": "2) List tools",
            "method": "POST",
            "url": "{{mcpBase}}/mcp",
            "auth": { "type": "inherited" },
            "headers": [
              { "enabled": true, "name": "Content-Type",   "value": "application/json" },
              { "enabled": true, "name": "Accept",         "value": "application/json" },
              { "enabled": true, "name": "Mcp-Session-Id", "value": "{{mcpSessionId}}" }
            ],
            "queryParams": [],
            "pathParams": [],
            "body": {
              "type": "text",
              "text": {
                "format": "application/json",
                "value": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 2,\n  \"method\": \"tools/list\"\n}"
              }
            }
          },
          {
            "id": "req_mcp_tools_call",
            "name": "3) Invoke tool — case.raiseTicket",
            "method": "POST",
            "url": "{{mcpBase}}/mcp",
            "auth": { "type": "inherited" },
            "headers": [
              { "enabled": true, "name": "Content-Type",   "value": "application/json" },
              { "enabled": true, "name": "Accept",         "value": "application/json" },
              { "enabled": true, "name": "Mcp-Session-Id", "value": "{{mcpSessionId}}" }
            ],
            "queryParams": [],
            "pathParams": [],
            "body": {
              "type": "text",
              "text": {
                "format": "application/json",
                "value": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 3,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"case.raiseTicket\",\n    \"arguments\": {\n      \"tradeId\": \"T-300\",\n      \"category\": \"ReferenceData\",\n      \"summary\": \"MCP test\"\n    }\n  }\n}"
              }
            }
          },
          {
            "id": "req_mcp_ping",
            "name": "4) Ping",
            "method": "POST",
            "url": "{{mcpBase}}/mcp",
            "auth": { "type": "inherited" },
            "headers": [
              { "enabled": true, "name": "Content-Type",   "value": "application/json" },
              { "enabled": true, "name": "Accept",         "value": "application/json" },
              { "enabled": true, "name": "Mcp-Session-Id", "value": "{{mcpSessionId}}" }
            ],
            "queryParams": [],
            "pathParams": [],
            "body": {
              "type": "text",
              "text": {
                "format": "application/json",
                "value": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 4,\n  \"method\": \"ping\"\n}"
              }
            }
          },
          {
            "id": "req_mcp_delete",
            "name": "5) Terminate session",
            "method": "DELETE",
            "url": "{{mcpBase}}/mcp",
            "auth": { "type": "inherited" },
            "headers": [
              { "enabled": true, "name": "Mcp-Session-Id", "value": "{{mcpSessionId}}" }
            ],
            "queryParams": [],
            "pathParams": [],
            "body": { "type": "none" }
          }
        ]
      },
      {
        "id": "col_mcp_sse",
        "name": "MCP — Legacy SSE (2024-11-05)",
        "auth": { "type": "none" },
        "icon": { "name": "bubble", "color": "purple" },
        "requests": [
          {
            "id": "req_sse_open",
            "name": "1) Open SSE stream (note sessionId from endpoint event)",
            "method": "GET",
            "url": "{{mcpBase}}/sse",
            "auth": { "type": "inherited" },
            "headers": [],
            "queryParams": [],
            "pathParams": [],
            "body": { "type": "none" }
          },
          {
            "id": "req_sse_tools_list",
            "name": "2) tools/list via POST /message",
            "method": "POST",
            "url": "{{mcpBase}}/message",
            "auth": { "type": "inherited" },
            "headers": [
              { "enabled": true, "name": "Content-Type", "value": "application/json" }
            ],
            "queryParams": [
              { "enabled": true, "name": "sessionId", "value": "{{mcpSessionId}}" }
            ],
            "pathParams": [],
            "body": {
              "type": "text",
              "text": {
                "format": "application/json",
                "value": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"tools/list\"\n}"
              }
            }
          }
        ]
      }
    ]
  }
}
