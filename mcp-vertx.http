@host = http://localhost:3001

### Initialize an MCP session
POST {{host}}/mcp
Content-Type: application/json
Accept: application/json

{
  "jsonrpc": "2.0",
  "id": 1,
  "method": "initialize",
  "params": {
    "protocolVersion": "2025-03-26",
    "capabilities": {},
    "clientInfo": {
      "name": "manual-test-client",
      "version": "1.0.0"
    }
  }
}

> {% client.global.set("mcpSessionId", response.headers.valueOf("Mcp-Session-Id")); %}

### Ping
POST {{host}}/mcp
Content-Type: application/json
Accept: application/json
Mcp-Session-Id: {{mcpSessionId}}

{
  "jsonrpc": "2.0",
  "id": 2,
  "method": "ping"
}

### List registered tools
POST {{host}}/mcp
Content-Type: application/json
Accept: application/json
Mcp-Session-Id: {{mcpSessionId}}

{
  "jsonrpc": "2.0",
  "id": 3,
  "method": "tools/list"
}

### Terminate the session
DELETE {{host}}/mcp
Accept: application/json
Mcp-Session-Id: {{mcpSessionId}}
