    {
      "_id": "fld_mcp_streamable",
      "_type": "request_group",
      "parentId": "wrk_vertx5mcp",
      "name": "MCP — Streamable HTTP (2025-03-26)"
    },
    {
      "_id": "req_mcp_init",
      "_type": "request",
      "parentId": "fld_mcp_streamable",
      "name": "1) Initialize session",
      "method": "POST",
      "url": "{{ _.mcpBase }}/mcp",
      "headers": [
        { "name": "Content-Type", "value": "application/json" },
        { "name": "Accept",       "value": "application/json" }
      ],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"initialize\",\n  \"params\": {\n    \"protocolVersion\": \"2025-03-26\",\n    \"capabilities\": {},\n    \"clientInfo\": { \"name\": \"insomnia\", \"version\": \"1.0\" }\n  }\n}"
      }
    },
    {
      "_id": "req_mcp_tools_list",
      "_type": "request",
      "parentId": "fld_mcp_streamable",
      "name": "2) List tools",
      "method": "POST",
      "url": "{{ _.mcpBase }}/mcp",
      "headers": [
        { "name": "Content-Type",   "value": "application/json" },
        { "name": "Accept",         "value": "application/json" },
        { "name": "Mcp-Session-Id", "value": "{{ _.mcpSessionId }}" }
      ],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 2,\n  \"method\": \"tools/list\"\n}"
      }
    },
    {
      "_id": "req_mcp_tools_call",
      "_type": "request",
      "parentId": "fld_mcp_streamable",
      "name": "3) Invoke tool — case.raiseTicket",
      "method": "POST",
      "url": "{{ _.mcpBase }}/mcp",
      "headers": [
        { "name": "Content-Type",   "value": "application/json" },
        { "name": "Accept",         "value": "application/json" },
        { "name": "Mcp-Session-Id", "value": "{{ _.mcpSessionId }}" }
      ],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 3,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"case.raiseTicket\",\n    \"arguments\": {\n      \"tradeId\": \"T-300\",\n      \"category\": \"ReferenceData\",\n      \"summary\": \"MCP test\"\n    }\n  }\n}"
      }
    },
    {
      "_id": "req_mcp_ping",
      "_type": "request",
      "parentId": "fld_mcp_streamable",
      "name": "4) Ping",
      "method": "POST",
      "url": "{{ _.mcpBase }}/mcp",
      "headers": [
        { "name": "Content-Type",   "value": "application/json" },
        { "name": "Accept",         "value": "application/json" },
        { "name": "Mcp-Session-Id", "value": "{{ _.mcpSessionId }}" }
      ],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 4,\n  \"method\": \"ping\"\n}"
      }
    },
    {
      "_id": "req_mcp_delete",
      "_type": "request",
      "parentId": "fld_mcp_streamable",
      "name": "5) Terminate session",
      "method": "DELETE",
      "url": "{{ _.mcpBase }}/mcp",
      "headers": [
        { "name": "Mcp-Session-Id", "value": "{{ _.mcpSessionId }}" }
      ],
      "body": {}
    },

    {
      "_id": "fld_mcp_sse",
      "_type": "request_group",
      "parentId": "wrk_vertx5mcp",
      "name": "MCP — Legacy SSE (2024-11-05)"
    },
    {
      "_id": "req_sse_open",
      "_type": "request",
      "parentId": "fld_mcp_sse",
      "name": "1) Open SSE connection (note sessionId from endpoint event)",
      "method": "GET",
      "url": "{{ _.mcpBase }}/sse",
      "headers": [],
      "body": {}
    },
    {
      "_id": "req_sse_tools_list",
      "_type": "request",
      "parentId": "fld_mcp_sse",
      "name": "2) tools/list (POST to /message)",
      "method": "POST",
      "url": "{{ _.mcpBase }}/message?sessionId={{ _.mcpSessionId }}",
      "headers": [
        { "name": "Content-Type", "value": "application/json" }
      ],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"tools/list\"\n}"
      }
